{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun",
      "node"
    ],
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "tsdown.config.ts",
    "test/unit/**/*.ts",
    "scripts/**/*.ts",
    "test/automation/**/*.ts",
    "release.config.ts"
  ]
}
