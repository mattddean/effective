{
  "name": "@mtdn.dev/effective",
  "version": "0.1.0",
  "description": "Capability modules, application-service contracts, and durable domain events for Effect",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattddean/effective.git"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "ai-docs",
    "skills"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit test/automation",
    "check": "bun run typecheck && bun run test && bun run build && publint --pack bun && bun scripts/check-package.ts",
    "prepublishOnly": "bun run check",
    "prepack": "bun run build",
    "effect:matrix": "bun scripts/effect-policy.ts matrix",
    "effect:check": "bun scripts/check-effect-version.ts",
    "effect:update": "bun scripts/update-effect-support.ts",
    "test:automation": "bun test test/automation",
    "release": "bun scripts/release.ts",
    "pack": "bun run build && bun scripts/package-artifact.ts",
    "check:supported": "bun scripts/check-supported.ts"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.4",
    "effect": "4.1.0 || 4.1.1 || 4.1.2"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-bun": "4.1.2",
    "@effect/sql-sqlite-bun": "4.1.2",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "drizzle-orm": "0.45.4",
    "effect": "4.1.2",
    "npm": "11.21.2",
    "publint": "0.3.25",
    "semantic-release": "25.0.9",
    "semver": "7.8.6",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "sideEffects": false,
  "packageManager": "bun@1.4.4"
}
